# Sao chép file này thành `.env` và chỉnh sửa giá trị nếu cần (Yêu cầu 11.2).
# Mọi biến đều có giá trị mặc định hợp lý trong AppConfig.from_env() khi không được định nghĩa.

# --- OLLAMA ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=120

# --- ChromaDB ---
CHROMA_PERSIST_DIR=data/vector_db
CHROMA_COLLECTION_NAME=rag_collection
CHROMA_IN_MEMORY=false

# --- Text Chunking ---
CHUNKER_STRATEGY=recursive
CHUNKER_CHUNK_SIZE=512
CHUNKER_CHUNK_OVERLAP=50

# --- Pipeline & Experiment Tracking ---
RAG_TOP_K=5
LOG_EXPERIMENTS=true
EXPERIMENT_LOG_DIR=experiments/logs
